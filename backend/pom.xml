<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.3</version>
    <relativePath/>
  </parent>

  <groupId>com.quill</groupId>
  <artifactId>ai-agent-backend</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>ai-agent-backend</name>
  <description>AI 内容创作平台 - 桌面 Agent 助手后端</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- 版本锁定：Spring AI 2.x 基于 Spring Boot 4 基线，与本项目不兼容，锁定 1.x GA -->
    <spring-ai.version>1.0.0</spring-ai.version>
    <poi.version>5.2.5</poi.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Web：REST + SSE（阶段1 D12 起 /api/chat 改为 SSE 流式） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>

    <!-- 模型：LOCAL 模式走 Ollama；USER_PROVIDED_API 模式阶段2 直连 OpenAI 兼容接口 -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-model-ollama</artifactId>
    </dependency>

    <!-- 文档导出：Apache POI(XWPF) 生成 .docx（阶段6 D47 使用） -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>${poi.version}</version>
    </dependency>

    <!-- 数据层：SQLite 单文件（v2.0 移除 MySQL/Redis，四表见 03-生产规范.md §1.7） -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>3.5.7</version>
    </dependency>

    <!--
      阶段4（D32/D33）数据层落地时追加，版本已核实：
        com.baomidou:mybatis-plus-spring-boot3-starter:3.5.7
        com.mysql:mysql-connector-j（由 Spring Boot BOM 管理）
        org.redisson:redisson-spring-boot-starter:3.50.0
      注意：这三个 starter 均带自动装配，MySQL/Redis 未启动会导致应用启动失败，
      故按"每个里程碑必须可运行"原则推迟引入，届时同步补充连接配置。
    -->

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
